import java.io.*;
import java.util.*;
import java.lang.*;

class day{
    public static void main(String arg[])
    {
        int d,y,w,day;
        System.out.println("enter the days=");
        Scanner sc=new Scanner(System.in);
        d=sc.nextInt();
        y=d/365;
        w=(d%365)/7;
        day=(d%365)%7;
        System.out.println("years="+y);
        System.out.println("weeks="+w);
        System.out.println("day="+day);
    }
}
